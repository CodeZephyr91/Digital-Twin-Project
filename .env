# 5G Lab Doctor & Remote Linux Operations Platform Configuration
# Copy this file to .env and adjust values for your environment.
# Note: Keep credentials safe and never commit sensitive keys to public repositories.

# Application Settings
DEMO_MODE=false
DASHBOARD_REFRESH_INTERVAL=2
DATABASE_PATH=lab_state.db
EVENT_RETENTION_DAYS=7

# Packet Capture Settings
CAPTURE_INTERFACE=
CAPTURE_FILTER=ip or icmp or udp or tcp
PROMISCUOUS_MODE=false
SAVE_PAYLOADS=false
MAX_PACKETS_IN_MEMORY=500

# 1. Core 5G (AMF/SMF/UPF) - 192.168.35.10 (CLI/SSH)
CORE_5G_IP=192.168.35.10
CORE_5G_USER=support
CORE_5G_PASS=Support@817&&
CORE_5G_USER2=su
CORE_5G_PASS2=TW0ULdCxH$6c;s

# 2. gNB Radio (5G NR euGNB) - 192.168.35.15 (CLI/SSH)
GNB_IP=192.168.35.15
GNB_USER=resonous
GNB_PASS=resonous
GNB_LOG_PATH=/home/tetra/euGNB/logs/msg_trace.log
GNB_EVENT_HISTORY_PATH=/home/tetra/euGNB/logs/eventHistory.log
GNB_ALARM_LOG_PATH=/home/tetra/euGNB/logs/AlarmLog.csv

# 3. Core IMS / cnpn (SIP Registrar / Vo5G) - 192.168.35.35 (SIP/SSH)
IMS_IP=192.168.35.35
SIP_PORT=5060
IMS_SIP_TRACE_PATH=/tmp/sip_trace.log

# 4. NMS Server - 192.168.35.6 (GUI/HTTP & SSH)
